rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '202310302@students.asu.edu.jo';
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly([
          'date', 'time', 'device', 'name', 'phone', 'faculty', 'reason', 'createdAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.time is string
        && request.resource.data.device in ['iPad', 'Laptop', 'Headphones']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.faculty is string
        && request.resource.data.faculty.size() > 0
        && request.resource.data.faculty.size() <= 120
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
